---
// A photo slot. Fills its positioned parent.
// Drop a file named <id>.jpg (or .jpeg/.png/.webp/.avif) into src/assets/photos/ and the build serves it
// as AVIF/WebP with width and height. Until then it renders the design reference's empty state.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  placeholder: string;
  alt?: string;
  sizes?: string;
}
const { id, placeholder, alt, sizes = '(max-width: 899px) 100vw, 50vw' } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const hit = Object.entries(photos).find(([p]) => p.slice(p.lastIndexOf('/') + 1).replace(/\.[^.]+$/, '') === id)?.[1].default;
const altText = alt ?? placeholder.replace(/^Fotografija[^:]*:\s*/, '');
---

{
  hit ? (
    <Picture
      src={hit}
      alt={altText}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= hit.width)}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      class="photo"
    />
  ) : (
    <span class="slot" aria-hidden="true">
      <span class="frame">
        <span class="empty">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
          <span class="cap">{placeholder}</span>
        </span>
        <span class="ring" />
      </span>
    </span>
  )
}

<style>
  .photo { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }

  .slot { position: absolute; inset: 0; display: block; font: 13px/1.3 system-ui, -apple-system, sans-serif; }
  .frame { position: absolute; inset: 0; overflow: hidden; background: rgba(127, 127, 127, .08); }
  .empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    padding: 12px;
    user-select: none;
  }
  .empty svg { display: block; opacity: .45; }
  .cap { display: block; max-width: 90%; font-weight: 500; letter-spacing: .01em; opacity: .75; }
  .ring { position: absolute; inset: 0; pointer-events: none; border: 1.5px dashed currentColor; opacity: .35; }
</style>
