---
// The reference's inline SVG icons, path for path.
const ICONS = {
  arrow: { d: 'M2.5 8h11M9 3.5 13.5 8 9 12.5', box: 16, sw: 1.6, size: 16, join: true },
  'arrow-left': { d: 'M13.5 8h-11M7 3.5 2.5 8 7 12.5', box: 16, sw: 1.5, size: 18, join: true },
  'arrow-up': { d: 'M8 13.5v-11M3.5 7 8 2.5 12.5 7', box: 16, sw: 1.6, size: 18, join: true },
  plus: { d: 'M8 2v12M2 8h12', box: 16, sw: 1.5, size: 16, join: false },
  check: { d: 'M5 12.5 10 17.5 19 7', box: 24, sw: 2.2, size: 24, join: true },
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
}
const { name, size } = Astro.props;
const i = ICONS[name];
const s = size ?? i.size;
---

<svg
  aria-hidden="true"
  width={s}
  height={s}
  viewBox={`0 0 ${i.box} ${i.box}`}
  fill="none"
  stroke="currentColor"
  stroke-width={i.sw}
  stroke-linecap="round"
  stroke-linejoin={i.join ? 'round' : undefined}><path d={i.d}></path></svg>

<style>
  svg { display: block; flex: none; }
</style>
